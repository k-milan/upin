# Existing PostgreSQL instance on the DigitalOcean Droplet.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://upin:replace-with-a-local-password@127.0.0.1:5438/upin

# Separate, revocable bearer token for the remote MCP endpoint.
UPIN_MCP_TOKEN=replace-with-a-long-random-token
